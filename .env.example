# =============================================
# Base de Datos Neon (PostgreSQL)
# =============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_HOST=ep-example-12345.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password
DB_SSLMODE=require

# =============================================
# Apache Kafka (Aiven)
# =============================================
KAFKA_BOOTSTRAP_SERVERS=kafka-service-project.aivencloud.com:12345
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_TOPIC_USER_EVENTS=user-events

# Credenciales SSL de Aiven Kafka (si usas certificados jks / pkcs12)
KAFKA_SSL_TRUSTSTORE_LOCATION=/path/to/client.truststore.jks
KAFKA_SSL_TRUSTSTORE_PASSWORD=secret
KAFKA_SSL_KEYSTORE_LOCATION=/path/to/client.keystore.p12
KAFKA_SSL_KEYSTORE_PASSWORD=secret
KAFKA_SSL_KEY_PASSWORD=secret

# Credenciales SASL de Aiven Kafka (si usas usuario y contraseña)
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="avnadmin" password="secret";

# =============================================
# Brevo Email
# =============================================
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_FROM_ADDRESS=tu-correo-verificado@dominio.com
BREVO_FROM_NAME=Gestion de Usuarios
JWT_SECRET=dGVzdC1vbmx5LWp3dC1zZWNyZXQtd2l0aC1hdC1sZWFzdC0zMi1ieXRlcw==
JWT_EXPIRATION_SECONDS=900
